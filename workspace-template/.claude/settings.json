{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Read",
      "Grep",
      "Glob",
      "Bash(ws-status*)",
      "Bash(ws-check *)",
      "Bash(ws-log *)",
      "Bash(ws-wait *)",
      "Bash(ws-standby status*)",
      "Bash(ws-submit *)",
      "Bash(hostname*)",
      "Bash(sacct*)",
      "Bash(squeue*)",
      "Bash(sinfo*)",
      "Bash(scontrol show*)",
      "Bash(module avail*)",
      "Bash(module list*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(ws-models*)",
      "Bash(ws-progress *)",
      "Bash(quota*)",
      "Bash(accounts*)",
      "Bash(seff *)"
    ],
    "ask": [
      "Bash(ws-submit *--yes*)",
      "Bash(ws-cancel *)",
      "Bash(ws-standby on*)",
      "Bash(ws-standby off*)",
      "Bash(* > *)",
      "Bash(* >> *)",
      "Bash(*>|*)",
      "Bash(* &> *)",
      "Bash(*<<*)",
      "Bash(*| tee *)",
      "Bash(*|tee *)",
      "Bash(*~/.*)",
      "Bash(*$HOME/.*)",
      "Bash(python -m venv*)",
      "Bash(python3 -m venv*)",
      "Bash(*-m venv *)",
      "Bash(*pip install*)"
    ],
    "deny": [
      "Bash(rm -rf*)",
      "Bash(scancel*)",
      "Bash(sbatch*)",
      "Bash(salloc*)",
      "Bash(srun*)",
      "Bash(curl*|*sh*)",
      "Bash(wget*|*sh*)",
      "Bash(git push*)",
      "Read(~/.ssh/**)",
      "Read(//work/hdd/*/ws-kit/secrets/**)",
      "Read(//work/hdd/*/ws-kit/keys/**)",
      "Read(//work/hdd/*/ws-kit/standby/key)",
      "Read(//path/to/site-lumen-key)",
      "Edit(~/.bashrc)",
      "Edit(~/.bash_profile)",
      "Edit(~/.profile)",
      "Edit(~/.ssh/**)",
      "Bash(rm -fr*)",
      "Bash(rm -r*)",
      "Bash(rm -f*)",
      "Bash(*/.bashrc*)",
      "Bash(*/.bash_profile*)",
      "Bash(*/.bash_aliases*)",
      "Bash(*/.profile*)",
      "Bash(*/.netrc*)",
      "Bash(*/.aws/*)",
      "Bash(*/.ssh/*)",
      "Bash(*/keys/*)",
      "Bash(*lumen-ws.key*)",
      "Bash(*/standby/key*)",
      "Bash(*WS_LUMEN_KEY_FILE*)",
      "Bash(*STANDBY_DIR*/key*)",
      "Bash(*huggingface/token*)",
      "Bash(*WS_ACCOUNT_*=*)",
      "Bash(*WS_PART_*=*)",
      "Bash(*WS_RES_*=*)",
      "Bash(*WS_*_MAX=*)",
      "Read(~/.netrc)",
      "Read(~/.aws/**)",
      "Read(~/.cache/huggingface/token)",
      "Edit(~/.bash_aliases)",
      "Edit(~/.netrc)",
      "Edit(~/.aws/**)",
      "Read(~/.config/lumen/**)",
      "Bash(*/.config/lumen/*)",
      "Bash(printenv*)",
      "Bash(env)",
      "Bash(env *)",
      "Bash(export -p*)",
      "Bash(declare -x*)",
      "Bash(declare -p*)",
      "Bash(*/proc/*/environ*)",
      "Bash(sh)",
      "Bash(sh -s*)",
      "Bash(bash)",
      "Bash(bash -s*)",
      "Bash(rm -R*)",
      "Bash(rm *--recursive*)",
      "Bash(git clean*)",
      "Bash(git reset --hard*)"
    ]
  }
}
