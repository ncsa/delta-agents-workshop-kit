# workshop.env: operator configuration, sourced by env.sh and lib/ws-common.sh.
# Copy to workshop.env beside env.sh and replace every <code>. Values already set in the
# environment win over this file (so WS_FAKE_NOW=10:40 ws-status works for rehearsals).

# Session date (YYYY-MM-DD); the workspace is $HOME/ws-$WS_DATE.
WS_DATE="2026-10-05"
# Read-only kit copy participants source env.sh from; empty means "the directory of env.sh".
WS_KIT_RO="/work/hdd/<code>/ws-kit"
# Allocation code of the workshop accounts (the <code> in <code>-delta-cpu).
WS_CODE="<code>"
# Slurm account for CPU jobs and the Code Server session.
WS_ACCOUNT_CPU="<code>-delta-cpu"
# Slurm account for GPU jobs.
WS_ACCOUNT_GPU="<code>-delta-gpu"
# A MAGNETIC reservation that takes the workshop accounts' jobs on its own (2026: one such reservation, from
# ops/go-live.sh --res-magnetic). Leave WS_RES_CPU and WS_RES_GPU empty with it: jobs then need no
# --reservation, and a job it has no room for starts outside it in the general queue. ws-status and
# ws-preflight show it; nothing adds it to a job.
WS_RES_MAGNETIC=""
# A named CPU reservation (Code Server sessions and the compile topic): ws-submit adds
# --reservation and clamps --time near its end, and a job never runs outside it. Empty with
# WS_RES_MAGNETIC, or when there is no reservation.
WS_RES_CPU=""
# A named GPU reservation for every participant GPU job (the same rules as WS_RES_CPU).
WS_RES_GPU=""
# GPU partition ws-submit forces for GPU jobs.
WS_PART_GPU="gpuA40x4"
# CPU partition ws-submit forces with --cpu.
WS_PART_CPU="cpu"
# Maximum GPUs per node per job.
WS_GPU_MAX="1"
# Maximum nodes per job (2 only with ws-submit --stretch).
WS_NODES_MAX="1"
# Maximum wall time per job (HH:MM:SS).
WS_TIME_MAX="00:15:00"
# Maximum memory per job.
WS_MEM_MAX="60g"
# Maximum CPUs per task.
WS_CPUS_MAX="16"
# The M7 job budget (Q43): ws-submit --yes refuses a workspace's open-ended job (a script under open/,
# or an LLMFlux run from open/) once it has this many in .ws/jobs.tsv, in any state; ws-status shows the
# count from M7 on. About 50 people share the reservation's 8 A40s and 2 CPU nodes.
WS_OPEN_JOBS_MAX="10"
# The session clock is off by default (operator, Oct 4): ws-status names the module from the PROGRESS.md
# checkpoints and reports no time box and no pace; the facilitator paces the room. WS_CLOCK="on" brings
# back the time boxes below and the ON-TIME/BEHIND/AHEAD pace.
WS_CLOCK="off"
# Module start times (local HH:MM), used only with WS_CLOCK="on": M0 launch. Shift them all (and WS_SESSION_END) to rehearse at
# another hour; ops/README.md, "The session clock".
WS_M0="10:12"
# M1 orient starts.
WS_M1="10:17"
# M2 plan starts.
WS_M2="10:23"
# M3 env starts.
WS_M3="10:31"
# M4 build starts.
WS_M4="10:36"
# M5 run starts.
WS_M5="10:42"
# M6 analyze starts.
WS_M6="10:52"
# M7 open starts: the open-ended part, once the prepared topic is at level 3.
WS_M7="10:58"
# M8 wrap starts.
WS_M8="11:38"
# Session end; ws-status reports DONE from here on.
WS_SESSION_END="11:45"
# Parent of the per-user share directories (unused in the session since C23; ws-init and pre-flight
# check 8 still create them).
WS_SHARE="/work/hdd/<code>/ws-share"
# Group-writable directory where ws-preflight writes <user>.json.
WS_REPORTS="/work/hdd/<code>/ws-reports"
# Workshop Lumen API key file (opencode reads it with {file:}); never print it. Optional: see WS_LUMEN_KEY.
WS_LUMEN_KEY_FILE="/work/hdd/<code>/ws-kit/keys/lumen-ws.key"
# Which Lumen key opencode.json uses (provider "lumen", models lumen/<id>): auto, site, personal or
# workshop. site: the NCSA key the hpc-gpt module ships; personal: ~/.config/lumen/key (mode 600);
# workshop: WS_LUMEN_KEY_FILE. auto: personal if that file exists, else workshop if WS_LUMEN_KEY_FILE
# holds a real key (not the publish placeholder), else site. A participant overrides it with
# ws-init --lumen-key MODE (kept for later runs).
WS_LUMEN_KEY="auto"
# The Lumen models participants see on /models, in this order (bare ids, space-separated; only models
# that answer: vet them with ws-models --all). Each needs a row in lib/lumen-models.tsv; this file wins
# over the environment. 2026 (Q42): glm-5.3, its fallback glm-5.3-flash, and qwen3.8-27b as another
# family; nemotron-3-super-120b-a12b answers but is not offered (C21 gate: 10-minute first replies).
WS_LUMEN_MODELS="glm-5.3 glm-5.3-flash qwen3.8-27b"
# Standby backend directory holding endpoint, token and status files.
WS_STANDBY_DIR="/work/hdd/<code>/ws-kit/standby"
# Lustre copy of the LLMFlux 2.0.0 container (ops/stage-data.sh --container); empty means the module's own.
WS_LLMFLUX_CONTAINERS_DIR="/work/hdd/<code>/ws-kit/containers/2.0.0"
# Default Lumen model id (bare; one of WS_LUMEN_MODELS). 2026 (Q41): glm-5.3; swap to glm-5.3-flash if
# the Lumen owners say glm-5.3 cannot serve about 50 sessions.
WS_MODEL_DEFAULT="glm-5.3"
# Backend a new workspace starts on (ws-init): lumen (lumen/$WS_MODEL_DEFAULT), standby
# (standby/ws-model) or split. split: the first field of `printf '%s' <netid> | cksum`, even -> lumen,
# odd -> standby. Participants who already ran ws-init keep theirs; they switch with ws-standby on|off.
WS_BACKEND_DEFAULT="lumen"
# Lumen model for session titles and summaries (bare id, one of WS_LUMEN_MODELS; the standby
# backend uses standby/ws-model for both). 2026 (L12): qwen3.8-27b, tested, off the GLM deployment.
WS_SMALL_MODEL="qwen3.8-27b"
# Rehearsal clock: HH:MM or "YYYY-MM-DD HH:MM"; empty means the real clock.
WS_FAKE_NOW=""
